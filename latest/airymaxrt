       exit 2 ;;
esac
if [ "$AIRYRT_PROFILE" = "auto" ]; then
    _HW_ASSESS="$(assess_hardware)"
    AIRYRT_PROFILE="${_HW_ASSESS%%|*}"
    log info "硬件评估: 内存 ${_HW_ASSESS#*|}"
    log info "自动画像: $AIRYRT_PROFILE"
fi
log debug "AIRYRT_PROFILE=$AIRYRT_PROFILE"


boot_line() {
    printf '\033[2m›\033[0m %s\n' "$*" >&2
}

diag_daemons() {
    local spec name sock critical="" degraded=""
    for spec in "${WAIT_SOCKS[@]}"; do
        name="${spec%%|*}"; sock="${spec#*|}"
        case "$name" in
            llm_d|think_d|agent_d|tool_d)
                critical="${critical:+$critical }$name"
                ;;
            *)
                degraded="${degraded:+$degraded }$name"
                ;;
        esac
    done
    if [ -n "$degraded" ]; then
        log warn "能力 daemon 未就绪（界面可用，能力受限）: ${degraded}；日志: $AIRY_HOME/logs/*.out"
    fi
    if [ -n "$critical" ]; then
        log error "关键 daemon 未就绪: ${critical}（对话/认知/执行链路必需）"
        local _lines _l
        for name in $critical; do
            _lines="$(tail -n 3 "$AIRY_HOME/logs/${name}.out" 2>/dev/null | grep -v 'nohup: ignoring input' | tr '\n' ' ' | sed 's/  */ /g')" || true
            [ -n "$_lines" ] && log error "  ${name}: ${_lines}"
        done
        log error "处理: 'airymaxrt doctor' 检查组件，或删除 $RUNTIME_DIR 残留 socket 后重试"
    fi
}

