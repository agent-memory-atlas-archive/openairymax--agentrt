upsert_profile_var() {
    local key="$1" val="$2"
    mkdir -p "$AIRY_HOME/config"
    if grep -q "^${key}=" "$PROFILE_ENV" 2>/dev/null; then
        sed_inplace "s|^${key}=.*|${key}=${val}|" "$PROFILE_ENV"
    else
        printf '%s=%s\n' "$key" "$val" >>"$PROFILE_ENV"
    fi
    chmod 600 "$PROFILE_ENV" 2>/dev/null || true
}

