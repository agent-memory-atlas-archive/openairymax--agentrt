_stop_all() {
    local pids=("$@") i j remaining deadline
    [ "${#pids[@]}" -eq 0 ] && return 0
    log debug "并行停止 ${#pids[@]} 个进程：发送 TERM"
    for i in "${!pids[@]}"; do
        if kill -0 "${pids[$i]}" 2>/dev/null; then
            kill "${pids[$i]}" 2>/dev/null || true
        else
            pids[$i]=""   # 已退出，标记跳过
        fi
    done
    deadline=$((SECONDS + 15))
    remaining="${#pids[@]}"
    while [ "$remaining" -gt 0 ] && [ "$SECONDS" -lt "$deadline" ]; do
        remaining=0
        for j in "${!pids[@]}"; do
            [ -n "${pids[$j]}" ] || continue
            if ! kill -0 "${pids[$j]}" 2>/dev/null; then
                log info "已停止进程（PID=${pids[$j]}）"
                pids[$j]=""
            else
                remaining=$((remaining + 1))
            fi
        done
        [ "$remaining" -gt 0 ] && sleep 0.5
    done
    for j in "${!pids[@]}"; do
        if [ -n "${pids[$j]}" ] && kill -0 "${pids[$j]}" 2>/dev/null; then
            log warn "进程（PID=${pids[$j]}）未响应 TERM，强制 KILL"
            kill -9 "${pids[$j]}" 2>/dev/null || true
        fi
    done
}

cleanup() {
    if [ "$DAEMONS_STARTED" != "1" ] && [ -z "$TUI_PID" ]; then
        log debug "清理跳过：本次未拉起任何进程"
        return 0
    fi
    log debug "清理开始：停止本次拉起的 TUI 与守护进程"
    local stop_pids=()
    [ -n "$TUI_PID" ] && stop_pids+=("$TUI_PID")
    [ -n "$GATEWAY_PID" ] && stop_pids+=("$GATEWAY_PID")
    stop_pids+=("${ALL_DAEMON_PIDS[@]}")
    _stop_all "${stop_pids[@]}"
    wait 2>/dev/null || true
    for sock in "${DAEMON_SOCKS[@]:-}"; do
        if [ -n "$sock" ] && [ -S "$sock" ]; then
            rm -f "$sock" 2>/dev/null
            log debug "清理 stale socket: $sock"
        fi
    done
    log debug "清理完成"
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

if [ -z "$GATEWAY_BIN" ] && [ -z "$LLM_BIN" ]; then
    log warn "gateway_d 与 llm_d 均未找到，将以 OFFLINE 模式进入（对话功能不可用）。"
    log warn "构建 daemons：cd \"$AIRYRT_HOME/agentrt\" && cmake -B build && cmake --build build -j"
else
    for _pf in "$RUNTIME_DIR"/*.pid; do
        [ -f "$_pf" ] || continue
        _p="$(cat "$_pf" 2>/dev/null)"
        if [ -z "$_p" ] || ! kill -0 "$_p" 2>/dev/null; then
            rm -f "$_pf"
            log debug "清理 stale pid 文件: $_pf"
        fi
    done
    _LOG_KEEP_DAYS="${AIRYRT_LOG_KEEP_DAYS:-7}"
    if command -v find >/dev/null 2>&1 && [ -d "$AIRY_HOME/logs" ]; then
        _CUTOFF=$(( $(date +%s) - _LOG_KEEP_DAYS * 86400 ))
        while IFS= read -r _old; do
            [ -n "$_old" ] || continue
            rm -f "$_old"
            log debug "清理过期运行时日志: $_old"
        done < <(find "$AIRY_HOME/logs" -maxdepth 1 -type f \
                     \( -name 'agent_*.log' -o -name '*.out' -o -name '*.pid' \) \
                     ! -newermt "@$_CUTOFF" -print 2>/dev/null)
    fi
    ALL_DAEMON_PIDS=()
    DAEMONS_STARTED=1
    REUSED_COUNT=0       # 复用已在线实例数（状态展示用，避免误导"0 个"）
    declare -a WAIT_SOCKS=()   # 待等待 socket 规格：`名称|socket路径`
    declare -a DAEMON_SOCKS=()

    _launch_daemon() {
        local bin="$1" sock="$2" bname
        bname="${bin##*/}"
        bname="${bname:-daemon}"
        if [ ! -x "$bin" ]; then
            log warn "$bname 未找到，跳过"
            return 0
        fi
        if _sock_alive "$sock"; then
            REUSED_COUNT=$((REUSED_COUNT + 1))
            log info "$bname 已在运行（复用 ${sock}）"
            return 0
        fi
        if [ -S "$sock" ]; then
            log warn "$bname 检测到 stale socket（无监听），移除后重新拉起: $sock"
            rm -f "$sock"
        fi
        nohup "$bin" >"$AIRY_HOME/logs/${bname}.out" 2>&1 &
        ALL_DAEMON_PIDS+=("$!")
        WAIT_SOCKS+=("$bname|$sock")
        DAEMON_SOCKS+=("$sock")
        log info "$bname 已拉起（PID=$!），日志: $AIRY_HOME/logs/${bname}.out"
    }

    if [ -x "$LLM_BIN" ]; then
        if _sock_alive "$RUNTIME_DIR/llm.sock"; then
            REUSED_COUNT=$((REUSED_COUNT + 1))
            log info "llm_d 已在运行（复用 $RUNTIME_DIR/llm.sock）"
        else
            if [ -S "$RUNTIME_DIR/llm.sock" ]; then
                log warn "llm_d 检测到 stale socket（无监听），移除后重新拉起: $RUNTIME_DIR/llm.sock"
                rm -f "$RUNTIME_DIR/llm.sock"
            fi
            if [ -f "$MODEL_CONFIG" ]; then
                log debug "llm_d 使用模型配置: $MODEL_CONFIG"
                nohup "$LLM_BIN" --manager "$MODEL_CONFIG" >"$AIRY_HOME/logs/llm_d.out" 2>&1 &
            else
                log warn "模型配置不存在（${MODEL_CONFIG}），llm_d 使用默认配置"
                nohup "$LLM_BIN" >"$AIRY_HOME/logs/llm_d.out" 2>&1 &
            fi
            ALL_DAEMON_PIDS+=("$!")
            WAIT_SOCKS+=("llm_d|$RUNTIME_DIR/llm.sock")
            DAEMON_SOCKS+=("$RUNTIME_DIR/llm.sock")
            log info "llm_d 已拉起（PID=$!），日志: $AIRY_HOME/logs/llm_d.out"
        fi
    fi

    if [ -n "$THINK_BIN" ]; then
        _launch_daemon "$THINK_BIN" "$RUNTIME_DIR/think.sock"
    else
        log warn "think_d 未找到，双思考（GCCP+GRAD）不可用，gateway 将降级直连"
    fi

    _launch_daemon "$(find_tool AIRY_AGENT_BIN agent_d "$AIRY_HOME/bin/agent_d" "$AIRYRT_HOME/agentrt/build/bin/agent_d" "$AIRYRT_HOME/build/bin/agent_d")" "$RUNTIME_DIR/agent.sock"
    _launch_daemon "$(find_tool AIRY_TOOL_BIN tool_d "$AIRY_HOME/bin/tool_d" "$AIRYRT_HOME/agentrt/build/bin/tool_d" "$AIRYRT_HOME/build/bin/tool_d")" "$RUNTIME_DIR/tool.sock"
    for _d in "$AIRY_HOME"/bin/*_d; do
        [ -f "$_d" ] || continue
        _b="${_d##*/}"
        case "$_b" in
            gateway_d|llm_d|think_d|agent_d|tool_d) continue ;;
        esac
        [ "$AIRYRT_PROFILE" = "minimal" ] && continue
        [ -x "$_d" ] || continue
        _launch_daemon "$_d" "$RUNTIME_DIR/${_b%_d}.sock"
    done

    _gw_port_available() {
        if command -v python3 >/dev/null 2>&1; then
            python3 -c "import socket,sys; s=socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1); s.bind(('127.0.0.1',int(sys.argv[1]))); s.close()" "$1" 2>/dev/null
        else
            (echo >/dev/tcp/127.0.0.1/"$1") 2>/dev/null && return 1
            return 0
        fi
    }
    GW_START="yes"   # 默认启动；gateway 已在线或探测到在线实例时置 no 复用
    if [ "$GATEWAY_ALIVE" = "1" ]; then
        GW_START="no"
        log info "gateway 已在线（${GATEWAY_URL}），复用（生命周期不受本次会话管理）"
    else
        for _p in "$GATEWAY_PORT" 8083 8084 8085 8086 8087 8088 8089 8090; do
            if _gw_port_available "$_p"; then
                if [ "$_p" != "$GATEWAY_PORT" ]; then
                    log warn "端口 $GATEWAY_PORT 被占用（残留连接），gateway 改用端口 $_p"
                    GATEWAY_PORT="$_p"
                    GATEWAY_URL="http://127.0.0.1:${GATEWAY_PORT}"
                fi
                break
            fi
            if wait_for_health "http://127.0.0.1:$_p" 1; then
                if [ "$_p" != "$GATEWAY_PORT" ]; then
                    log info "端口 $_p 已有在线 gateway，直接复用"
                    GATEWAY_PORT="$_p"
                    GATEWAY_URL="http://127.0.0.1:${GATEWAY_PORT}"
                fi
                GW_START="no"
                break
            fi
        done
    fi
    if [ "$GW_START" = "yes" ]; then
        log debug "执行: nohup \"$GATEWAY_BIN\" -h 127.0.0.1 -p \"$GATEWAY_PORT\" > \"$AIRY_HOME/logs/gateway_d.out\" 2>&1 &"
        nohup "$GATEWAY_BIN" -h 127.0.0.1 -p "$GATEWAY_PORT" >"$AIRY_HOME/logs/gateway_d.out" 2>&1 &
        GATEWAY_PID=$!
        log info "gateway_d 已拉起（PID=${GATEWAY_PID}），日志: $AIRY_HOME/logs/gateway_d.out"
    else
        log info "gateway 复用在线实例（${GATEWAY_URL}），本次会话不接管其生命周期"
    fi
    mkdir -p "$RUNTIME_DIR" 2>/dev/null || true
    printf '%s\n' "$GATEWAY_PORT" > "$RUNTIME_DIR/gateway.port" 2>/dev/null || true

    wait_all_socks() {
        [ "${#WAIT_SOCKS[@]}" -eq 0 ] && return 0
        local deadline=$((SECONDS + 10)) spec name sock
        local remaining=() all_done
        while [ "${#WAIT_SOCKS[@]}" -gt 0 ] && [ "$SECONDS" -lt "$deadline" ]; do
            remaining=()
            all_done=1
            for spec in "${WAIT_SOCKS[@]}"; do
                name="${spec%%|*}"; sock="${spec#*|}"
                if _sock_alive "$sock"; then
                    log info "$name 就绪（${sock}）"
                else
                    remaining+=("$spec")
                    all_done=0
                fi
            done
            WAIT_SOCKS=("${remaining[@]}")
            [ "$all_done" = "1" ] && return 0
            sleep 0.25
        done
        for spec in "${WAIT_SOCKS[@]}"; do
            name="${spec%%|*}"
            log warn "$name socket 未就绪，查看日志: $AIRY_HOME/logs/${name}.out"
        done
        return 1
    }
    WAIT_TOTAL="${#WAIT_SOCKS[@]}"   # 本次新拉起的 daemon 数（复用实例不在其中）
    if wait_all_socks; then
        if [ "$REUSED_COUNT" -gt 0 ] && [ "$WAIT_TOTAL" -gt 0 ]; then
            boot_line "守护进程群就绪（复用 ${REUSED_COUNT} 个 + 新拉 ${WAIT_TOTAL} 个）"
        elif [ "$REUSED_COUNT" -gt 0 ]; then
            boot_line "守护进程群就绪（在线 ${REUSED_COUNT} 个全部复用）"
        else
            boot_line "守护进程群就绪（${WAIT_TOTAL} 个）"
        fi
    else
        diag_daemons
        boot_line "守护进程群部分未就绪（未就绪 ${#WAIT_SOCKS[@]} 个，详见上方诊断）"
    fi

    if wait_for_health "$GATEWAY_URL" 15; then
        log info "gateway 就绪（${GATEWAY_URL}）"
        boot_line "gateway 就绪（${GATEWAY_URL}）"
    else
        log warn "gateway 未能就绪（${GATEWAY_URL}），查看日志: $AIRY_HOME/logs/gateway_d.out"
        boot_line "gateway 未就绪（${GATEWAY_URL}），降级模式…"
        if [ -n "$CLI_BIN" ]; then
            log warn "降级：airy_cli 直连 daemon 群（不依赖 gateway）"
        else
            log error "交互界面依赖 gateway，但 airy_cli 缺失，无法降级"
            log error "可执行 'airymaxrt doctor' 检查组件，或删除 $RUNTIME_DIR 下残留 socket 后重试"
            exit 1
        fi
    fi
fi

launch_frontend
rc=$?
log info "交互界面退出（exit=${rc}）"
exit $rc
